# 우하단 설정 버튼에서 입력하면 이 파일(.env)에 자동 저장됩니다. 직접 편집해도 됩니다. .env 는 git에 올라가지 않습니다.
# 장부 파일 위치 (비우면 app 상위 폴더의 의료인공지능센터_지출장부_2026.xlsx)
# LEDGER_XLSX=C:/경로/장부.xlsx
# 웹앱 포트 (기본 8791)
# LEDGER_PORT=8791

# 구글 로그인 (README 2-1). 허용 이메일이 비어 있으면 아무도 로그인할 수 없습니다
LEDGER_ALLOWED_EMAILS=
# LEDGER_OAUTH_CLIENT=google_client_secret.json
# LEDGER_OAUTH_REDIRECT=http://127.0.0.1:8791/auth/callback
# LEDGER_SESSION_SECRET=   (첫 로그인 때 자동 생성)

# AI (선택·유료)
LEDGER_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LEDGER_MODEL=claude-sonnet-5-5
LEDGER_EFFORT=medium
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1
OPENAI_REASONING_EFFORT=

# 테스트용: 드라이브 대신 app/drive_mock 로컬 폴더에 증빙 저장
# LEDGER_DRIVE_MOCK=1
# MCP 서버를 읽기 전용으로 (쓰기 도구 미등록)
# LEDGER_MCP_READONLY=1
